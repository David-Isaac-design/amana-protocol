{
  "cli": {
    "requireCommit": true
  },
  "expo": {
    "name": "Amana Protocol",
    "slug": "amana-vault-mobile",
    "version": "0.1.0",
    "scheme": "amanavault",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTabletMode": true,
      "bundleIdentifier": "com.amana.mobile",
      "scheme": "amanavault",
      "icon": "./assets/icon.png",
      "associatedDomains": [
        "applinks:amanavault.app",
        "applinks:www.amanavault.app"
      ],
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Amana Protocol uses local network to communicate with backend services",
        "NSBonjourServiceTypes": ["_amanavault._tcp"]
      }
    },
    "android": {
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "scheme": "amanavault",
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            { "scheme": "https", "host": "amanavault.app", "pathPrefix": "/trades" },
            { "scheme": "https", "host": "amanavault.app", "pathPrefix": "/disputes" },
            { "scheme": "https", "host": "www.amanavault.app", "pathPrefix": "/trades" },
            { "scheme": "https", "host": "www.amanavault.app", "pathPrefix": "/disputes" }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "data": [{ "scheme": "amanavault" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION"]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#ffffff",
          "sounds": ["./assets/notification-sound.wav"]
        }
      ]
    ],
    "extra": {}
  }
}
