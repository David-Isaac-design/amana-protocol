{
  "name": "Amana Protocol",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "stable",
      "profile": "minimal",
      "components": "clippy,rustfmt",
      "targets": "wasm32-unknown-unknown"
    }
  },
  "postCreateCommand": "bash .devcontainer/install-rust-tools.sh"
}
